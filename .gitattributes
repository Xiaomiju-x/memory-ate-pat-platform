# Normalize source and documentation for reproducible diffs.
* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf
NOTICE text eol=lf

*.py      text eol=lf
*.md      text eol=lf
*.json    text eol=lf
*.js      text eol=lf
*.cjs     text eol=lf
*.mjs     text eol=lf
*.toml    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.cff     text eol=lf
*.html    text eol=lf
*.svg     text eol=lf
*.xml     text eol=lf
.nvmrc    text eol=lf
LICENSE   text eol=lf

# Windows launchers and ATE exchange files are consumed primarily on Windows.
*.bat     text eol=crlf
*.ps1     text eol=crlf
*.pat     text eol=crlf
*.prg     text eol=crlf
*.tim     text eol=crlf
*.lvl     text eol=crlf
*.stil    text eol=crlf
*.wgl     text eol=crlf
*.csv     text eol=crlf
*.txt     text eol=crlf

# License texts are packed into the national-finals portable app. Keep their
# bytes stable across Windows/Linux clones so a clean tag rebuild is auditable.
national-final/licenses/*.txt text eol=lf

# Fixed-width ATE exchange files and human-readable vector tables may use
# trailing spaces as meaningful column padding. Do not flag that generated
# alignment as a source-code whitespace error.
*.pat     whitespace=-trailing-space
*.prg     whitespace=-trailing-space
*.tim     whitespace=-trailing-space
*.lvl     whitespace=-trailing-space
*.stil    whitespace=-trailing-space
*.wgl     whitespace=-trailing-space
*.csv     whitespace=-trailing-space
*.txt     whitespace=-trailing-space

# Binary assets must never be line-ending normalized.
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.ico     binary
*.pdf     binary
*.docx    binary
*.pptx    binary
*.xlsx    binary
*.zip     binary
*.7z      binary
*.rar     binary
*.exe     binary
*.pkg     binary
*.pyz     binary
