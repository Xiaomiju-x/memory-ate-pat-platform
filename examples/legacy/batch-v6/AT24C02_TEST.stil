  V { "all_pins" = DDDDDU; } // Write bit=1 Poll attempt 2 bit[7]
  V { "all_pins" = DDDDUU; } // SCL↑ (data valid)
  V { "all_pins" = DDDDDU; } // SCL↓
  V { "all_pins" = DDDDDD; } // Write bit=0 Poll attempt 2 bit[6]
  V { "all_pins" = DDDDUD; } // SCL↑ (data valid)
  V { "all_pins" = DDDDDD; } // SCL↓
  V { "all_pins" = DDDDDU; } // Write bit=1 Poll attempt 2 bit[5]
  V { "all_pins" = DDDDUU; } // SCL↑ (data valid)
  V { "all_pins" = DDDDDU; } // SCL↓
