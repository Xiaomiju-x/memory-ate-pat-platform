  V { "all_pins" = DDDDDD; } // Write bit=0 Poll attempt 0 bit[6]
  V { "all_pins" = DDDDUD; } // SCL↑ (data valid)
  V { "all_pins" = DDDDDD; } // SCL↓
  V { "all_pins" = DDDDDU; } // Write bit=1 Poll attempt 0 bit[5]
  V { "all_pins" = DDDDUU; } // SCL↑ (data valid)
  V { "all_pins" = DDDDDU; } // SCL↓
  V { "all_pins" = DDDDDD; } // Write bit=0 Poll attempt 0 bit[4]
  V { "all_pins" = DDDDUD; } // SCL↑ (data valid)
  V { "all_pins" = DDDDDD; } // SCL↓
  V { "all_pins" = DDDDDD; } // Write bit=0 Poll attempt 0 bit[3]
  V { "all_pins" = DDDDUD; } // SCL↑ (data valid)
  V { "all_pins" = DDDDDD; } // SCL↓
  V { "all_pins" = DDDDDD; } // Write bit=0 Poll attempt 0 bit[2]
  V { "all_pins" = DDDDUD; } // SCL↑ (data valid)
  V { "all_pins" = DDDDDD; } // SCL↓
  V { "all_pins" = DDDDDD; } // Write bit=0 Poll attempt 0 bit[1]
  V { "all_pins" = DDDDUD; } // SCL↑ (data valid)
  V { "all_pins" = DDDDDD; } // SCL↓
  V { "all_pins" = DDDDDD; } // Write bit=0 Poll attempt 0 bit[0]
  V { "all_pins" = DDDDUD; } // SCL↑ (data valid)
  V { "all_pins" = DDDDDD; } // SCL↓
  V { "all_pins" = DDDDDZ; } // Poll NACK (device busy, attempt 0)
  V { "all_pins" = DDDDUH; } // NACK check (expect HIGH)
  V { "all_pins" = DDDDDX; } // SCL↓
  V { "all_pins" = DDDDDD; } // STOP Setup
  V { "all_pins" = DDDDUD; } // STOP (SCL↑)
