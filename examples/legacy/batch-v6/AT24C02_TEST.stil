  V { "all_pins" = DDDDDX; } // SCL↓
  V { "all_pins" = DDDDDZ; } // Read bit CurrentAddrRead data bit[7]
  V { "all_pins" = DDDDUH; } // SCL↑ (compare=H)
  V { "all_pins" = DDDDDX; } // SCL↓
  V { "all_pins" = DDDDDZ; } // Read bit CurrentAddrRead data bit[6]
  V { "all_pins" = DDDDUH; } // SCL↑ (compare=H)
  V { "all_pins" = DDDDDX; } // SCL↓
  V { "all_pins" = DDDDDZ; } // Read bit CurrentAddrRead data bit[5]
  V { "all_pins" = DDDDUH; } // SCL↑ (compare=H)
  V { "all_pins" = DDDDDX; } // SCL↓
  V { "all_pins" = DDDDDZ; } // Read bit CurrentAddrRead data bit[4]
  V { "all_pins" = DDDDUH; } // SCL↑ (compare=H)
  V { "all_pins" = DDDDDX; } // SCL↓
  V { "all_pins" = DDDDDZ; } // Read bit CurrentAddrRead data bit[3]
  V { "all_pins" = DDDDUH; } // SCL↑ (compare=H)
  V { "all_pins" = DDDDDX; } // SCL↓
  V { "all_pins" = DDDDDZ; } // Read bit CurrentAddrRead data bit[2]
  V { "all_pins" = DDDDUH; } // SCL↑ (compare=H)
  V { "all_pins" = DDDDDX; } // SCL↓
  V { "all_pins" = DDDDDZ; } // Read bit CurrentAddrRead data bit[1]
  V { "all_pins" = DDDDUH; } // SCL↑ (compare=H)
  V { "all_pins" = DDDDDX; } // SCL↓
  V { "all_pins" = DDDDDZ; } // Read bit CurrentAddrRead data bit[0]
  V { "all_pins" = DDDDUL; } // SCL↑ (compare=L)
  V { "all_pins" = DDDDDX; } // SCL↓
  V { "all_pins" = DDDDDU; } // NACK (end current addr read)
  V { "all_pins" = DDDDUU; } // NACK (SDA=HIGH)
  V { "all_pins" = DDDDDU; } // SCL↓
  V { "all_pins" = DDDDDD; } // STOP Setup
  V { "all_pins" = DDDDUD; } // STOP (SCL↑)
  V { "all_pins" = DDDDUU; } // STOP Condition (SDA↑)
  V { "all_pins" = DDDDUU; } // === Functional Test Complete ===
  V { "all_pins" = DDDDUU; }
  V { "all_pins" = DDDDUU; }
  V { "all_pins" = DDDDUU; }
}
