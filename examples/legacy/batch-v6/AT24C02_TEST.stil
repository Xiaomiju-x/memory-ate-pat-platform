  V { "all_pins" = DDDDUD; } // SCL↑ (data valid)
  V { "all_pins" = DDDDDD; } // SCL↓
  V { "all_pins" = DDDDDD; } // Write bit=0 Poll attempt 1 bit[2]
  V { "all_pins" = DDDDUD; } // SCL↑ (data valid)
  V { "all_pins" = DDDDDD; } // SCL↓
  V { "all_pins" = DDDDDD; } // Write bit=0 Poll attempt 1 bit[1]
  V { "all_pins" = DDDDUD; } // SCL↑ (data valid)
  V { "all_pins" = DDDDDD; } // SCL↓
  V { "all_pins" = DDDDDD; } // Write bit=0 Poll attempt 1 bit[0]
