STIL 1.0 {
  Design 2005;
}

Header {
  Title "AT24C02 ATE Test Pattern";
  Date "2026-03-22";
  Source "ATE Pattern Generator Platform v6.0.0";
}

Signals {
  "A0" In;
  "A1" In;
  "A2" In;
  "WP" In;
  "SCL" In;
  "SDA" InOut;
}

SignalGroups {
  "all_pins" = '"A0"+"A1"+"A2"+"WP"+"SCL"+"SDA"';
}

Timing "i2c_timing" {
  WaveformTable "wft_std" {
    Period '2500ns';
    Waveforms {
      "A0" { 01ZHLX { '0ns' D/D/Z/H/L/X; } }
      "A1" { 01ZHLX { '0ns' D/D/Z/H/L/X; } }
      "A2" { 01ZHLX { '0ns' D/D/Z/H/L/X; } }
      "WP" { 01ZHLX { '0ns' D/D/Z/H/L/X; } }
      "SCL" { P { '0ns' D; '1250ns' U; } }
      "SDA" { 01ZHLX { '0ns' D/D/Z/H/L/X; } }
    }
  }
}

PatternBurst "burst_all" {
  PatList {
    "OS_TEST";
    "DC_TEST";
    "FUNC_TEST";
  }
}

Pattern "OS_TEST" {
  "OS_ALL_LOW": V { "all_pins" = DDDDDD; } // OS_TEST: All pins drive LOW
  V { "all_pins" = DDDDDD; } // Hold LOW
  V { "all_pins" = DDDDDD; } // Hold LOW
  V { "all_pins" = DDDDDD; } // Hold LOW
  "OS_ALL_HIGH": V { "all_pins" = UUUUUU; } // OS_TEST: All pins drive HIGH
  V { "all_pins" = UUUUUU; } // Hold HIGH
  V { "all_pins" = UUUUUU; } // Hold HIGH
  V { "all_pins" = UUUUUU; } // Hold HIGH
  "OS_WALK1_A0": V { "all_pins" = UDDDDD; } // Walking-1: A0=HIGH, others=LOW
  V { "all_pins" = UDDDDD; } // Hold A0=HIGH
  V { "all_pins" = UDDDDD; } // Hold A0=HIGH
  "OS_WALK1_A1": V { "all_pins" = DUDDDD; } // Walking-1: A1=HIGH, others=LOW
  V { "all_pins" = DUDDDD; } // Hold A1=HIGH
  V { "all_pins" = DUDDDD; } // Hold A1=HIGH
  "OS_WALK1_A2": V { "all_pins" = DDUDDD; } // Walking-1: A2=HIGH, others=LOW
  V { "all_pins" = DDUDDD; } // Hold A2=HIGH
  V { "all_pins" = DDUDDD; } // Hold A2=HIGH
  "OS_WALK1_WP": V { "all_pins" = DDDUDD; } // Walking-1: WP=HIGH, others=LOW
  V { "all_pins" = DDDUDD; } // Hold WP=HIGH
  V { "all_pins" = DDDUDD; } // Hold WP=HIGH
  "OS_WALK1_SCL": V { "all_pins" = DDDDUD; } // Walking-1: SCL=HIGH, others=LOW
  V { "all_pins" = DDDDUD; } // Hold SCL=HIGH
  V { "all_pins" = DDDDUD; } // Hold SCL=HIGH
  "OS_WALK1_SDA": V { "all_pins" = DDDDDU; } // Walking-1: SDA=HIGH, others=LOW
  V { "all_pins" = DDDDDU; } // Hold SDA=HIGH
  V { "all_pins" = DDDDDU; } // Hold SDA=HIGH
  "OS_WALK0_A0": V { "all_pins" = DUUUUU; } // Walking-0: A0=LOW, others=HIGH
  V { "all_pins" = DUUUUU; } // Hold A0=LOW
  V { "all_pins" = DUUUUU; } // Hold A0=LOW
  "OS_WALK0_A1": V { "all_pins" = UDUUUU; } // Walking-0: A1=LOW, others=HIGH
  V { "all_pins" = UDUUUU; } // Hold A1=LOW
  V { "all_pins" = UDUUUU; } // Hold A1=LOW
  "OS_WALK0_A2": V { "all_pins" = UUDUUU; } // Walking-0: A2=LOW, others=HIGH
  V { "all_pins" = UUDUUU; } // Hold A2=LOW
  V { "all_pins" = UUDUUU; } // Hold A2=LOW
  "OS_WALK0_WP": V { "all_pins" = UUUDUU; } // Walking-0: WP=LOW, others=HIGH
  V { "all_pins" = UUUDUU; } // Hold WP=LOW
  V { "all_pins" = UUUDUU; } // Hold WP=LOW
  "OS_WALK0_SCL": V { "all_pins" = UUUUDU; } // Walking-0: SCL=LOW, others=HIGH
  V { "all_pins" = UUUUDU; } // Hold SCL=LOW
  V { "all_pins" = UUUUDU; } // Hold SCL=LOW
  "OS_WALK0_SDA": V { "all_pins" = UUUUUD; } // Walking-0: SDA=LOW, others=HIGH
  V { "all_pins" = UUUUUD; } // Hold SDA=LOW
  V { "all_pins" = UUUUUD; } // Hold SDA=LOW
  "OS_END": V { "all_pins" = DDDDUU; } // Return to IDLE
  V { "all_pins" = DDDDUU; }
}

Pattern "DC_TEST" {
  "DC_ISB_START": V { "all_pins" = DDDDUU; } // === DC ISB Test: Standby Current ===
  V { "all_pins" = DDDDUU; } // ISB: IDLE state (measure ICC)
  V { "all_pins" = DDDDUU; } // ISB: IDLE state (measure ICC)
  V { "all_pins" = DDDDUU; } // ISB: IDLE state (measure ICC)
  V { "all_pins" = DDDDUU; } // ISB: IDLE state (measure ICC)
  V { "all_pins" = DDDDUU; } // ISB: IDLE state (measure ICC)
  V { "all_pins" = DDDDUU; } // ISB: IDLE state (measure ICC)
  V { "all_pins" = DDDDUU; } // ISB: IDLE state (measure ICC)
  V { "all_pins" = DDDDUU; } // ISB: IDLE state (measure ICC)
  "DC_ISB_MEAS": V { "all_pins" = DDDDUU; } // ISB measurement point
  V { "all_pins" = DDDDUU; } // ISB: continue IDLE
  V { "all_pins" = DDDDUU; } // ISB: continue IDLE
  V { "all_pins" = DDDDUU; } // ISB: continue IDLE
  V { "all_pins" = DDDDUU; } // ISB: continue IDLE
  "DC_ICC_START": V { "all_pins" = DDDDUU; } // === DC ICC Test: Operating Current (Read) ===
  V { "all_pins" = DDDDUU; } // START Setup
  V { "all_pins" = DDDDUD; } // START Condition (SDA↓)
  V { "all_pins" = DDDDDD; } // START Hold
  V { "all_pins" = DDDDDU; } // Write bit=1 DevAddr+R (ICC test) bit[7]
  V { "all_pins" = DDDDUU; } // SCL↑ (data valid)
  V { "all_pins" = DDDDDU; } // SCL↓
  V { "all_pins" = DDDDDD; } // Write bit=0 DevAddr+R (ICC test) bit[6]
  V { "all_pins" = DDDDUD; } // SCL↑ (data valid)
  V { "all_pins" = DDDDDD; } // SCL↓
  V { "all_pins" = DDDDDU; } // Write bit=1 DevAddr+R (ICC test) bit[5]
  V { "all_pins" = DDDDUU; } // SCL↑ (data valid)
  V { "all_pins" = DDDDDU; } // SCL↓
  V { "all_pins" = DDDDDD; } // Write bit=0 DevAddr+R (ICC test) bit[4]
  V { "all_pins" = DDDDUD; } // SCL↑ (data valid)
  V { "all_pins" = DDDDDD; } // SCL↓
  V { "all_pins" = DDDDDD; } // Write bit=0 DevAddr+R (ICC test) bit[3]
  V { "all_pins" = DDDDUD; } // SCL↑ (data valid)
  V { "all_pins" = DDDDDD; } // SCL↓
  V { "all_pins" = DDDDDD; } // Write bit=0 DevAddr+R (ICC test) bit[2]
  V { "all_pins" = DDDDUD; } // SCL↑ (data valid)
  V { "all_pins" = DDDDDD; } // SCL↓
  V { "all_pins" = DDDDDD; } // Write bit=0 DevAddr+R (ICC test) bit[1]
  V { "all_pins" = DDDDUD; } // SCL↑ (data valid)
  V { "all_pins" = DDDDDD; } // SCL↓
  V { "all_pins" = DDDDDU; } // Write bit=1 DevAddr+R (ICC test) bit[0]
  V { "all_pins" = DDDDUU; } // SCL↑ (data valid)
  V { "all_pins" = DDDDDU; } // SCL↓
  V { "all_pins" = DDDDDZ; } // ACK
  V { "all_pins" = DDDDUL; } // ACK check (expect LOW)
  V { "all_pins" = DDDDDX; } // SCL↓
  V { "all_pins" = DDDDDZ; } // Read bit Read data (ICC meas) bit[7]
  V { "all_pins" = DDDDUX; } // SCL↑ (compare=X)
  V { "all_pins" = DDDDDX; } // SCL↓
  V { "all_pins" = DDDDDZ; } // Read bit Read data (ICC meas) bit[6]
  V { "all_pins" = DDDDUX; } // SCL↑ (compare=X)
  V { "all_pins" = DDDDDX; } // SCL↓
  V { "all_pins" = DDDDDZ; } // Read bit Read data (ICC meas) bit[5]
  V { "all_pins" = DDDDUX; } // SCL↑ (compare=X)
  V { "all_pins" = DDDDDX; } // SCL↓
  V { "all_pins" = DDDDDZ; } // Read bit Read data (ICC meas) bit[4]
  V { "all_pins" = DDDDUX; } // SCL↑ (compare=X)
  V { "all_pins" = DDDDDX; } // SCL↓
  V { "all_pins" = DDDDDZ; } // Read bit Read data (ICC meas) bit[3]
  V { "all_pins" = DDDDUX; } // SCL↑ (compare=X)
  V { "all_pins" = DDDDDX; } // SCL↓
  V { "all_pins" = DDDDDZ; } // Read bit Read data (ICC meas) bit[2]
  V { "all_pins" = DDDDUX; } // SCL↑ (compare=X)
  V { "all_pins" = DDDDDX; } // SCL↓
  V { "all_pins" = DDDDDZ; } // Read bit Read data (ICC meas) bit[1]
  V { "all_pins" = DDDDUX; } // SCL↑ (compare=X)
  V { "all_pins" = DDDDDX; } // SCL↓
  V { "all_pins" = DDDDDZ; } // Read bit Read data (ICC meas) bit[0]
  V { "all_pins" = DDDDUX; } // SCL↑ (compare=X)
  V { "all_pins" = DDDDDX; } // SCL↓
  V { "all_pins" = DDDDDU; } // NACK from master
  V { "all_pins" = DDDDUU; } // NACK (SDA=HIGH)
  V { "all_pins" = DDDDDU; } // SCL↓
  V { "all_pins" = DDDDDD; } // STOP Setup
  V { "all_pins" = DDDDUD; } // STOP (SCL↑)
  V { "all_pins" = DDDDUU; } // STOP Condition (SDA↑)
  V { "all_pins" = DDDDUU; } // ICC Read complete
  V { "all_pins" = DDDDUU; }
  "DC_ICC_W_START": V { "all_pins" = DDDDUU; } // === DC ICC Write Test ===
  V { "all_pins" = DDDDUU; } // === Byte Write: addr=0x00 data=0x55 ===
  V { "all_pins" = DDDDUU; }
  V { "all_pins" = DDDDUU; } // START Setup
  V { "all_pins" = DDDDUD; } // START Condition (SDA↓)
  V { "all_pins" = DDDDDD; } // START Hold
  V { "all_pins" = DDDDDU; } // Write bit=1 DevAddr+W bit[7]
  V { "all_pins" = DDDDUU; } // SCL↑ (data valid)
  V { "all_pins" = DDDDDU; } // SCL↓
  V { "all_pins" = DDDDDD; } // Write bit=0 DevAddr+W bit[6]
  V { "all_pins" = DDDDUD; } // SCL↑ (data valid)
  V { "all_pins" = DDDDDD; } // SCL↓
  V { "all_pins" = DDDDDU; } // Write bit=1 DevAddr+W bit[5]
  V { "all_pins" = DDDDUU; } // SCL↑ (data valid)
  V { "all_pins" = DDDDDU; } // SCL↓
  V { "all_pins" = DDDDDD; } // Write bit=0 DevAddr+W bit[4]
  V { "all_pins" = DDDDUD; } // SCL↑ (data valid)
  V { "all_pins" = DDDDDD; } // SCL↓
  V { "all_pins" = DDDDDD; } // Write bit=0 DevAddr+W bit[3]
  V { "all_pins" = DDDDUD; } // SCL↑ (data valid)
  V { "all_pins" = DDDDDD; } // SCL↓
  V { "all_pins" = DDDDDD; } // Write bit=0 DevAddr+W bit[2]
  V { "all_pins" = DDDDUD; } // SCL↑ (data valid)
  V { "all_pins" = DDDDDD; } // SCL↓
  V { "all_pins" = DDDDDD; } // Write bit=0 DevAddr+W bit[1]
  V { "all_pins" = DDDDUD; } // SCL↑ (data valid)
  V { "all_pins" = DDDDDD; } // SCL↓
  V { "all_pins" = DDDDDD; } // Write bit=0 DevAddr+W bit[0]
  V { "all_pins" = DDDDUD; } // SCL↑ (data valid)
  V { "all_pins" = DDDDDD; } // SCL↓
  V { "all_pins" = DDDDDZ; } // ACK after DevAddr
  V { "all_pins" = DDDDUL; } // ACK check (expect LOW)
  V { "all_pins" = DDDDDX; } // SCL↓
  V { "all_pins" = DDDDDD; } // Write bit=0 WordAddr bit[7]
  V { "all_pins" = DDDDUD; } // SCL↑ (data valid)
  V { "all_pins" = DDDDDD; } // SCL↓
  V { "all_pins" = DDDDDD; } // Write bit=0 WordAddr bit[6]
  V { "all_pins" = DDDDUD; } // SCL↑ (data valid)
  V { "all_pins" = DDDDDD; } // SCL↓
  V { "all_pins" = DDDDDD; } // Write bit=0 WordAddr bit[5]
  V { "all_pins" = DDDDUD; } // SCL↑ (data valid)
  V { "all_pins" = DDDDDD; } // SCL↓
  V { "all_pins" = DDDDDD; } // Write bit=0 WordAddr bit[4]
  V { "all_pins" = DDDDUD; } // SCL↑ (data valid)
  V { "all_pins" = DDDDDD; } // SCL↓
  V { "all_pins" = DDDDDD; } // Write bit=0 WordAddr bit[3]
  V { "all_pins" = DDDDUD; } // SCL↑ (data valid)
  V { "all_pins" = DDDDDD; } // SCL↓
  V { "all_pins" = DDDDDD; } // Write bit=0 WordAddr bit[2]
  V { "all_pins" = DDDDUD; } // SCL↑ (data valid)
  V { "all_pins" = DDDDDD; } // SCL↓
  V { "all_pins" = DDDDDD; } // Write bit=0 WordAddr bit[1]
  V { "all_pins" = DDDDUD; } // SCL↑ (data valid)
  V { "all_pins" = DDDDDD; } // SCL↓
  V { "all_pins" = DDDDDD; } // Write bit=0 WordAddr bit[0]
  V { "all_pins" = DDDDUD; } // SCL↑ (data valid)
  V { "all_pins" = DDDDDD; } // SCL↓
  V { "all_pins" = DDDDDZ; } // ACK after WordAddr
  V { "all_pins" = DDDDUL; } // ACK check (expect LOW)
  V { "all_pins" = DDDDDX; } // SCL↓
  V { "all_pins" = DDDDDD; } // Write bit=0 Data bit[7]
  V { "all_pins" = DDDDUD; } // SCL↑ (data valid)
  V { "all_pins" = DDDDDD; } // SCL↓
  V { "all_pins" = DDDDDU; } // Write bit=1 Data bit[6]
  V { "all_pins" = DDDDUU; } // SCL↑ (data valid)
  V { "all_pins" = DDDDDU; } // SCL↓
  V { "all_pins" = DDDDDD; } // Write bit=0 Data bit[5]
  V { "all_pins" = DDDDUD; } // SCL↑ (data valid)
  V { "all_pins" = DDDDDD; } // SCL↓
  V { "all_pins" = DDDDDU; } // Write bit=1 Data bit[4]
  V { "all_pins" = DDDDUU; } // SCL↑ (data valid)
  V { "all_pins" = DDDDDU; } // SCL↓
  V { "all_pins" = DDDDDD; } // Write bit=0 Data bit[3]
  V { "all_pins" = DDDDUD; } // SCL↑ (data valid)
  V { "all_pins" = DDDDDD; } // SCL↓
  V { "all_pins" = DDDDDU; } // Write bit=1 Data bit[2]
  V { "all_pins" = DDDDUU; } // SCL↑ (data valid)
  V { "all_pins" = DDDDDU; } // SCL↓
  V { "all_pins" = DDDDDD; } // Write bit=0 Data bit[1]
  V { "all_pins" = DDDDUD; } // SCL↑ (data valid)
  V { "all_pins" = DDDDDD; } // SCL↓
  V { "all_pins" = DDDDDU; } // Write bit=1 Data bit[0]
  V { "all_pins" = DDDDUU; } // SCL↑ (data valid)
  V { "all_pins" = DDDDDU; } // SCL↓
  V { "all_pins" = DDDDDZ; } // ACK after Data
  V { "all_pins" = DDDDUL; } // ACK check (expect LOW)
  V { "all_pins" = DDDDDX; } // SCL↓
  V { "all_pins" = DDDDDD; } // STOP Setup
  V { "all_pins" = DDDDUD; } // STOP (SCL↑)
  V { "all_pins" = DDDDUU; } // STOP Condition (SDA↑)
  V { "all_pins" = DDDDUU; } // === ACK Polling (wait for write cycle) ===
  V { "all_pins" = DDDDUU; }
  V { "all_pins" = DDDDUU; } // START Setup
  V { "all_pins" = DDDDUD; } // START Condition (SDA↓)
  V { "all_pins" = DDDDDD; } // START Hold
  V { "all_pins" = DDDDDU; } // Write bit=1 Poll attempt 0 bit[7]
  V { "all_pins" = DDDDUU; } // SCL↑ (data valid)
